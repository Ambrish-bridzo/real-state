{
  "name": "leadflow-backend",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "gateway",
    "services/*"
  ],
  "scripts": {
    "dev": "nx affected -t dev --parallel=30",
    "dev:all": "nx run-many -t dev --parallel=30",
    "dev:core": "nx run-many -t dev -p gateway auth-service core-engine --parallel=4",
    "dev:sales": "nx run-many -t dev -p gateway leads-api deals-api --parallel=4",
    "dev:ops": "nx run-many -t dev -p gateway tasks-api meetings-api reports-api --parallel=5",
    "graph": "nx graph"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/imap-simple": "^4.2.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^7.0.11",
    "@types/socket.io": "^3.0.1",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.0",
    "imap-simple": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.3",
    "mongoose": "^9.2.4",
    "nodemailer": "^8.0.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nx/js": "^22.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.18.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "nx": "22.6.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}